    "@effect/platform-node": "4.1.4",
    "@oxlint/plugins": "1.93.0",
    "@playwright/test": "1.65.0",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@types/node": "^24.19.2",
    "alchemy": "2.0.0-beta.87",
    "effect": "4.1.4",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.14.0"
