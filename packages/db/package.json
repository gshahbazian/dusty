{
  "name": "@dusty/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": {
      "types": [
        "./src/*.ts",
        "./src/*.tsx",
        "./src/*/index.ts"
      ],
      "default": "./src/*"
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-rc.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261112.1",
    "@types/node": "^24.19.2",
    "drizzle-kit": "1.0.0-rc.5",
    "miniflare": "4.20260730.0",
    "typescript": "7.0.2"
  }
}
