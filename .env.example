# Copy to .env and fill in. `alchemy deploy` and `alchemy dev` read this file.

# The one email allowed in. Used for the Access policy and the app's own check.
OWNER_EMAIL=you@example.com

# Your Cloudflare Zero Trust team domain (deploy only; not needed for dev).
# Find it under Zero Trust > Settings > Custom Pages, or the URL of your login page.
ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com

# Optional sync settings (defaults shown). See docs/002_m1_sync_design.md.
# When the scheduled sync runs (cron syntax).
# SYNC_CRON=0 * * * *
# On-demand syncs (page load, refresh) this soon after the last one are skipped.
# SYNC_SKIP_WINDOW_MINUTES=5
# A run ends within this long, last feed included; the next run continues.
# On-demand runs must finish inside Cloudflare's 30 s waitUntil limit.
# SYNC_SCHEDULED_BUDGET_SECONDS=600
# SYNC_ON_DEMAND_BUDGET_SECONDS=25
# Feeds fetched at once, and how long one fetch may take.
# SYNC_CONCURRENCY=6
# SYNC_FEED_TIMEOUT_SECONDS=15
# Read articles are deleted this long after being read.
# READ_RETENTION_DAYS=14
# A deleted article's key is forgotten once it has left its feed this long.
# PRUNED_ITEM_RETENTION_DAYS=30
# A feed is failing after this long without a successful sync.
# FEED_FAILING_AFTER_HOURS=48
# A feed is stale when its newest article is older than this.
# FEED_STALE_AFTER_DAYS=90
